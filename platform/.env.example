# Copy to .env and fill in. Never commit .env.

# --- core
PUBLIC_WEB_URL=https://tada.ir
POSTGRES_PASSWORD=change-to-a-long-random-password
# 48+ random characters: openssl rand -base64 48
SESSION_SECRET=change-to-a-long-random-secret
NODE_ENV=production
# http = plain (first start, or TLS elsewhere); https = certificates in deploy/certs
NGINX_MODE=http

# --- payments (Zarinpal). Mock payments are refused in production.
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_TIMEOUT_MINUTES=20

# --- SMS (Kavenegar). The OTP template must exist in the Kavenegar panel with one %token.
SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=tada-otp
# Dedicated sender line for order updates (empty = no order SMS, OTP still works)
KAVENEGAR_SENDER=
SMS_ORDER_UPDATES=true

# --- accounting: none (CSV export only) or webhook (signed JSON invoice per paid order)
ACCOUNTING_DRIVER=none
ACCOUNTING_WEBHOOK_URL=
ACCOUNTING_WEBHOOK_SECRET=

# --- assistant: leave empty for guided mode. Any OpenAI-compatible endpoint you may legally use,
# e.g. a self-hosted open model behind vLLM or Ollama: http://llm:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
