{
  "name": "tada-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev:api": "pnpm --filter @tada/api dev",
    "dev:web": "pnpm --filter @tada/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @tada/api db:migrate",
    "db:seed": "pnpm --filter @tada/api db:seed",
    "e2e": "pnpm --filter @tada/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
